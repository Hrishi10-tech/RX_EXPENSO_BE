# Copy to .env and adjust. Every variable has a safe development default except where noted.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://expenso:expenso@localhost:5432/expenso
# Production: a random string of at least 32 characters (openssl rand -base64 48). The server refuses weak values.
JWT_SECRET=change-me-to-a-long-random-string
# Origins allowed to call the API from a browser (CORS and Socket.IO), comma separated.
WEB_ORIGIN=http://localhost:5173
# Public address of the finance console, used in emails. Defaults to the first WEB_ORIGIN.
# WEB_URL=https://expenso.rhythmrx.ai
# Serve the built console from this process (defaults to ../web/dist when it exists).
# WEB_DIST_DIR=../web/dist

# Files: local disk in development, S3 (or MinIO) in production.
STORAGE_DRIVER=local
STORAGE_DIR=./data/uploads
# S3_BUCKET=expenso-files
# S3_REGION=ap-south-1
# S3_ENDPOINT=            # only for MinIO or another S3-compatible store
MAX_UPLOAD_MB=20

# Email for one-time codes, app links and the daily digest. Unset: messages are written to the log.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Expenso <expenso@rhythmrx.ai>
# APP_DOWNLOAD_URL=https://expenso.rhythmrx.ai/app
# DIGEST_HOUR_IST=9
# Who a deactivated person should contact. Defaults to the first active administrator.
# SUPPORT_CONTACT_NAME=Farah Siddiqui
# SUPPORT_CONTACT_EMAIL=it@rhythmrx.ai

# Development only: return one-time codes in API responses. The server refuses to start with this in production.
DEV_ECHO_OTP=true
# Optional Firebase service account JSON for push notifications (install firebase-admin too).
# FCM_SERVICE_ACCOUNT=./firebase-service-account.json
# Run the scheduler and the export worker in this process (keep on for at least one instance).
RUN_JOBS=true
JOB_INTERVAL_SECONDS=30
# Apply database migrations at start-up (set false if you migrate separately).
# MIGRATE_ON_START=true
# LOG_LEVEL=info
